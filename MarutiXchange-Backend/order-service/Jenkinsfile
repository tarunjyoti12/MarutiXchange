pipeline {
    agent any

    tools {
        maven 'Maven-3.9.6'
        jdk 'JDK-21'
    }

    environment {
        APP_NAME        = 'order-service'
        APP_VERSION     = '0.0.1-SNAPSHOT'
        DOCKER_IMAGE    = "marutixchange/${APP_NAME}"
        DOCKER_TAG      = "${APP_VERSION}-${BUILD_NUMBER}"
        SONAR_PROJECT   = 'marutixchange-order-service'
        JAVA_OPTS       = '-Xmx512m'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        .
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo ${DOCKER_PASS} | docker login \
                            -u ${DOCKER_USER} \
                            --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    docker stop order-service || true
                    docker rm   order-service || true
                    docker run -d \
                        --name order-service \
                        --network marutixchange-network \
                        -p 8066:8066 \
                        -e SPRING_PROFILES_ACTIVE=prod \
                        -e SPRING_DATASOURCE_PASSWORD=admin \
                        -e APP_JWT_SECRET=marutixchange-super-secret-key-must-be-256-bits-long-for-hs256 \
                        -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://admin:admin123@eureka-server:8761/eureka/ \
                        --restart unless-stopped \
                        ${DOCKER_IMAGE}:${DOCKER_TAG}
                """
            }
        }

        stage('Health Check') {
            steps {
                sh """
                    sleep 20
                    curl --fail --silent \
                        http://localhost:8066/actuator/health \
                        | grep -q 'UP' \
                        && echo 'Health check PASSED' \
                        || (echo 'Health check FAILED' && exit 1)
                """
            }
        }
    }
}