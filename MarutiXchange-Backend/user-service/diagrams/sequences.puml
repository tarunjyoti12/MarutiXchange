@startuml AccountLock_Sequence
title Account Lock on Failed Login Attempts

actor Client
participant UserController
participant UserService
participant UserRepository
database PostgreSQL

loop 5 times - Failed Login Attempts
    Client -> UserController: POST /login\n(wrong password)
    activate UserController
    
    UserController -> UserService: login(request)
    activate UserService
    
    UserService -> UserRepository: findByEmail(email)
    activate UserRepository
    UserRepository -> PostgreSQL: SELECT * FROM user WHERE email = ?
    PostgreSQL --> UserRepository: user
    UserRepository --> UserService: user
    deactivate UserRepository
    
    UserService -> UserService: Verify password - FAILS
    UserService -> UserService: handleFailedLogin()
    UserService -> UserService: Increment failedAttempts
    
    alt failedAttempts < 5
        UserService -> UserRepository: save(user)
        activate UserRepository
        UserRepository -> PostgreSQL: UPDATE user SET failed_attempts = ?
        PostgreSQL --> UserRepository: ok
        UserRepository --> UserService: updated_user
        deactivate UserRepository
        
        UserService --> UserService: throw InvalidCredentialsException
    else failedAttempts >= 5
        UserService -> UserService: Set accountLocked = true
        UserService -> UserService: Set lockTime = now
        
        UserService -> UserRepository: save(user)
        activate UserRepository
        UserRepository -> PostgreSQL: UPDATE user SET account_locked = true, lock_time = ?
        PostgreSQL --> UserRepository: ok
        UserRepository --> UserService: updated_user
        deactivate UserRepository
        
        UserService --> UserService: throw InvalidCredentialsException
    end
    
    deactivate UserService
    
    UserController --> Client: 401 UNAUTHORIZED
    deactivate UserController
end

note right of Client
  After 5 failed attempts, account is locked for 30 minutes
end note

Client -> UserController: POST /login\n(6th attempt)
activate UserController

UserController -> UserService: login(request)
activate UserService

UserService -> UserRepository: findByEmail(email)
activate UserRepository
UserRepository -> PostgreSQL: SELECT * FROM user WHERE email = ?
PostgreSQL --> UserRepository: user (accountLocked=true)
UserRepository --> UserService: user
deactivate UserRepository

UserService -> UserService: Check if account locked
UserService -> UserService: Check lock duration
alt lockTime + 30min > now
    UserService --> UserService: throw AccountLockedException
else lockTime + 30min <= now
    UserService -> UserService: Reset failed attempts
    UserService -> UserService: Unlock account
end

deactivate UserService

UserController --> Client: 403 FORBIDDEN\n(Account Locked)
deactivate UserController

@enduml
